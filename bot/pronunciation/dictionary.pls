    <alias> [lovingly] </alias>
  </lexeme>
  <lexeme>
    <grapheme>❤️</grapheme>
    <alias> [lovingly] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:tada:</grapheme>
    <alias> [excited] </alias>
  </lexeme>
  <lexeme>
    <grapheme>🎉</grapheme>
    <alias> [excited] </alias>
  </lexeme>
  <lexeme>
