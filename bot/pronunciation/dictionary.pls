<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
         xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
         alphabet="x-sampa"
         xml:lang="en-GB">
  <lexeme>
    <grapheme>Lerche</grapheme>
    <alias>Lerch</alias>
  </lexeme>
  <lexeme>
    <grapheme>lol</grapheme>
    <alias> [laughs] </alias>
  </lexeme>

  <!-- Joy and laughter -->
  <lexeme>
    <grapheme>:joy:</grapheme>
    <alias> [joy] </alias>
  </lexeme>
  <lexeme>
    <grapheme>😂</grapheme>
    <alias> [joy] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:rofl:</grapheme>
    <alias> [laughs harder] </alias>
  </lexeme>
  <lexeme>
    <grapheme>🤣</grapheme>
    <alias> [laughs harder] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:laughing:</grapheme>
    <alias> [laughs] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:sweat_smile:</grapheme>
    <alias> [nervous laugh] </alias>
  </lexeme>
  <lexeme>
    <grapheme>😅</grapheme>
    <alias> [nervous laugh] </alias>
  </lexeme>

  <!-- Happiness, affection, and celebration -->
  <lexeme>
