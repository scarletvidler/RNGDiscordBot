  </lexeme>
  <lexeme>
    <grapheme>:heart_eyes:</grapheme>
    <alias> [excited] </alias>
  </lexeme>
  <lexeme>
    <grapheme>😍</grapheme>
    <alias> [excited] </alias>
  </lexeme>
  <lexeme>
