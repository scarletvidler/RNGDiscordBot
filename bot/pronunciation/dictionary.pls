  </lexeme>
  <lexeme>
    <grapheme>😑</grapheme>
    <alias> [deadpan] </alias>
  </lexeme>

  <!-- Common reactions and gestures -->
  <lexeme>
    <grapheme>:thumbsup:</grapheme>
    <alias> [approvingly] </alias>
  </lexeme>
  <lexeme>
    <grapheme>👍</grapheme>
    <alias> [approvingly] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:+1:</grapheme>
    <alias> [approvingly] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:thumbsdown:</grapheme>
    <alias> [disapprovingly] </alias>
  </lexeme>
  <lexeme>
    <grapheme>👎</grapheme>
    <alias> [disapprovingly] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:-1:</grapheme>
    <alias> [disapprovingly] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:clap:</grapheme>
    <alias> [clapping] </alias>
  </lexeme>
  <lexeme>
    <grapheme>👏</grapheme>
    <alias> [clapping] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:wave:</grapheme>
    <alias> [cheerfully] </alias>
  </lexeme>
  <lexeme>
    <grapheme>👋</grapheme>
    <alias> [cheerfully] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:pray:</grapheme>
    <alias> [hopeful] </alias>
  </lexeme>
  <lexeme>
    <grapheme>🙏</grapheme>
    <alias> [hopeful] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:skull:</grapheme>
    <alias> [deadpan] </alias>
  </lexeme>
  <lexeme>
    <grapheme>💀</grapheme>
    <alias> [deadpan] </alias>
  </lexeme>
  <lexeme>
    <grapheme>:100:</grapheme>
    <alias> [emphatically] </alias>
  </lexeme>
  <lexeme>
    <grapheme>💯</grapheme>
    <alias> [emphatically] </alias>
